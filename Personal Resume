    <style>
        :root {
            --primary-color: #0F52BA;
            --secondary-color: #333333;
            --bg-color: #f4f7f6;
            --card-bg: #ffffff;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--secondary-color);
            margin: 0;
            padding: 20px;
            line-height: 1.6;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background-color: var(--card-bg);
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        header {
            display: flex;
            align-items: center;
            border-bottom: 2px solid var(--primary-color);
            padding-bottom: 20px;
            margin-bottom: 30px;
            gap: 20px;
        }

        .profile-img {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--primary-color);
        }

        .header-text h1 {
            margin: 0 0 10px 0;
            color: var(--primary-color);
        }

        .header-text p {
            margin: 0;
            font-size: 1.1em;
            font-weight: 500;
        }

        section {
            margin-bottom: 30px;
        }

        h2 {
            color: var(--primary-color);
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
        }

        .education-item, .hobby-item {
            margin-bottom: 15px;
        }

        .education-item h3 {
            margin: 0 0 5px 0;
        }

        .education-item p {
            margin: 0;
            color: #666;
        }

        .contact-list {
            list-style: none;
            padding: 0;
        }

        .contact-list li {
            margin-bottom: 10px;
        }

        .contact-list a {
            color: var(--primary-color);
            text-decoration: none;
        }

        .contact-list a:hover {
            text-decoration: underline;
        }
    </style>
</head>
