<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StudyFlow - Student Planner</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    tailwind.config = {
      darkMode: 'class'
    }
  </script>

  <style>
    body {
      font-family: Inter, Arial, sans-serif;
    }

    .task-completed {
      text-decoration: line-through;
      opacity: 0.55;
    }

    .task-card {
      transition: all 0.25s ease;
    }

    .task-card:hover {
      transform: translateY(-2px);
    }
  </style>
</head>

<body class="bg-gray-100 dark:bg-gray-950 text-gray-800 dark:text-white min-h-screen">

  <!-- NAVBAR -->
  <nav class="bg-white dark:bg-gray-900 shadow-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">

      <div>
        <h1 class="text-2xl font-bold text-indigo-600 dark:text-indigo-400">
          📚 StudyFlow
        </h1>
        <p class="text-xs text-gray-500 dark:text-gray-400">
          Student Study Planner
        </p>
      </div>

      <button onclick="toggleDarkMode()"
        class="bg-gray-100 dark:bg-gray-800 px-4 py-2 rounded-xl hover:bg-gray-200 dark:hover:bg-gray-700 transition">
        🌙
      </button>

    </div>
  </nav>


  <!-- MAIN -->
  <main class="max-w-6xl mx-auto px-4 py-8">

    <!-- HERO -->
    <section class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-3xl p-6 md:p-8 mb-8 shadow-lg">

      <div class="flex flex-col md:flex-row justify-between gap-6">

        <div>
          <p class="text-indigo-200">WELCOME BACK 👋</p>

          <h2 class="text-3xl md:text-4xl font-bold mt-2">
            Plan. Study. Succeed.
          </h2>

          <p class="mt-3 text-indigo-100">
            Organize your academic tasks and stay productive every day.
          </p>
        </div>

        <div class="bg-white/15 backdrop-blur-sm rounded-2xl p-5 min-w-[180px]">
          <p class="text-sm text-indigo-100">Today's Progress</p>

          <p id="progressText" class="text-3xl font-bold mt-1">
            0%
          </p>

          <div class="w-full bg-white/20 rounded-full h-2 mt-3">
            <div id="progressBar"
              class="bg-white h-2 rounded-full transition-all duration-500"
              style="width: 0%">
            </div>
          </div>
        </div>

      </div>

    </section>


    <!-- STATISTICS -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">

      <div class="bg-white dark:bg-gray-900 p-5 rounded-2xl shadow-sm">
        <p class="text-gray-500 text-sm">Total Tasks</p>
        <p id="totalTasks" class="text-3xl font-bold mt-1">0</p>
      </div>

      <div class="bg-white dark:bg-gray-900 p-5 rounded-2xl shadow-sm">
        <p class="text-gray-500 text-sm">Pending</p>
        <p id="pendingTasks" class="text-3xl font-bold text-orange-500 mt-1">0</p>
      </div>

      <div class="bg-white dark:bg-gray-900 p-5 rounded-2xl shadow-sm">
        <p class="text-gray-500 text-sm">Completed</p>
        <p id="completedTasks" class="text-3xl font-bold text-green-500 mt-1">0</p>
      </div>

      <div class="bg-white dark:bg-gray-900 p-5 rounded-2xl shadow-sm">
        <p class="text-gray-500 text-sm">High Priority</p>
        <p id="highTasks" class="text-3xl font-bold text-red-500 mt-1">0</p>
      </div>

    </section>


    <!-- ADD TASK -->
    <section class="bg-white dark:bg-gray-900 rounded-2xl shadow-md p-5 mb-6">

      <h3 class="text-xl font-bold mb-4">
        ➕ Add New Task
      </h3>

      <div class="grid md:grid-cols-4 gap-3">

        <input id="taskInput"
          type="text"
          placeholder="Enter your task..."
          class="md:col-span-2 px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 dark:bg-gray-800 outline-none focus:ring-2 focus:ring-indigo-500">

        <select id="priorityInput"
          class="px-4 py-3 rounded-xl border border-gray-200 dark:border-gray-700 dark:bg-gray-800 outline-none">
          <option value="Low">🟢 Low Priority</option>
          <option value="Medium" selected>🟡 Medium Priority</option>
          <option value="High">🔴 High Priority</option>
        </select>

        <button onclick="addTask()"
          class="bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold transition">
          Add Task
        </button>

      </div>

    </section>


    <!-- SEARCH & FILTER -->
    <section class="flex flex-col md:flex-row gap-3 mb-6">

      <input id="searchInput"
        oninput="renderTasks()"
        type="text"
        placeholder="🔍 Search tasks..."
        class="flex-1 px-4 py-3 bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 outline-none">

      <div class="flex gap-2">

        <button onclick="setFilter('all')"
          class="filter-btn px-4 py-2 rounded-xl bg-indigo-600 text-white">
          All
        </button>

        <button onclick="setFilter('pending')"
          class="filter-btn px-4 py-2 rounded-xl bg-white dark:bg-gray-900">
          Pending
        </button>

        <button onclick="setFilter('completed')"
          class="filter-btn px-4 py-2 rounded-xl bg-white dark:bg-gray-900">
          Completed
        </button>

      </div>

    </section>


    <!-- TASK LIST -->
    <section>

      <div class="flex justify-between items-center mb-4">

        <h3 class="text-xl font-bold">
          My Tasks
        </h3>

        <button onclick="clearCompleted()"
          class="text-sm text-red-500 hover:text-red-700">
          Clear Completed
        </button>

      </div>

      <div id="taskList" class="space-y-3"></div>

      <div id="emptyState"
        class="hidden text-center bg-white dark:bg-gray-900 rounded-2xl p-10 shadow-sm">

        <div class="text-5xl mb-3">🎉</div>

        <h3 class="text-xl font-bold">
          No tasks found!
        </h3>

        <p class="text-gray-500 mt-2">
          Add a new task and start being productive.
        </p>

      </div>

    </section>

  </main>


  <!-- FOOTER -->
  <footer class="text-center py-6 text-gray-500 dark:text-gray-400 text-sm">
    © 2026 StudyFlow | Student Productivity Application
  </footer>


<script>

  // ==============================
  // VARIABLES
  // ==============================

  let tasks = JSON.parse
